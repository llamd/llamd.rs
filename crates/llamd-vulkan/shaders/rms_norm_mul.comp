#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer X { float x[]; };
layout(std430, binding = 1) readonly  buffer W { float w[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform P { uint n; float eps; } pc;
shared float sh[256];
// The final norm, whose output the output projection quantizes itself.
void main() {
    uint t = gl_LocalInvocationID.x;
    uint base = gl_WorkGroupID.x * pc.n;
    float a = 0.0;
    for (uint i = t; i < pc.n; i += 256u) { float v = x[base + i]; a += v * v; }
    sh[t] = a;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) { if (t < st) sh[t] += sh[t + st]; barrier(); }
    float inv = inversesqrt(sh[0] / float(pc.n) + pc.eps);
    for (uint i = t; i < pc.n; i += 256u) o[base + i] = x[base + i] * inv * w[i];
}
