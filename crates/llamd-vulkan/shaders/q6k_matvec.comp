#version 450
//
// Planar Q6_K x Q8_K matvec, batched, for Vulkan compute on AMD.
//
// THIS IS THE SAME ARITHMETIC as crates/llamd-rocm/kernels/llamd_udot.hip, and
// deliberately so: the point of a second backend is a comparison on identical
// hardware, which is only meaningful if both compute the same thing. Both are
// validated against llamd_quant::dot_q6k_q8k.
//
// THE IDENTITY. Q6_K stores w in 0..63 before the -32; Q8_K activations are
// signed int8 and become unsigned as b = a + 128 (exactly a XOR 0x80). Over a
// 16-value scale group:
//
//   S sc*(w-32)*a = sc * [ S w*b - 128*S w - 32*S b + 32*128*16 ]
//
// `S w*b` is dotPacked4x8AccSatEXT per sequence; `S w` is the same instruction
// against 0x01010101 and is SHARED by every sequence; `S b` is precomputed.
// RADV reports integerDotProduct4x8BitPackedUnsignedAccelerated = true, so this
// is the hardware instruction and not an emulation.
//
// WHY PLANAR. Four weights pack into a uint only if their value indices are
// consecutive and share a scale group. ggml's 210-byte interleaved blocks are
// 2-byte aligned and give neither; the planar repack gives sixteen consecutive
// indices, which is exactly one scale group. It also lets every load here be a
// plain uint from an std430 buffer with no byte addressing.
//
// PROVENANCE: the Q6_K layout is from llama.cpp / ggml (MIT, (c) 2023-2026 The
// ggml authors).

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

const int MAX_SEQ = 8;

// The whole planar weight tensor, addressed as uints. Plane offsets arrive as
// push constants already divided by 4.
layout(std430, binding = 0) readonly buffer W  { uint  w[];  };
// Activation, biased to unsigned and packed 4 bytes per uint.
layout(std430, binding = 1) readonly buffer QB { uint  qb[]; };
// Per-16 group sums of the biased activation.
layout(std430, binding = 2) readonly buffer SB { int   sb[]; };
// Per-block activation scale.
layout(std430, binding = 3) readonly buffer AD { float ad[]; };
layout(std430, binding = 4) writeonly buffer O { float outv[]; };

layout(push_constant) uniform Push {
    uint ql_u; uint qh_u; uint sc_u; uint d_u;
    uint blocks; uint rows; uint nseq; uint pad;
} pc;
#include "common.glsl"
#include "q6k.glsl"

// The accumulator width, a SPECIALIZATION CONSTANT.
//
// WHY. `float acc[MAX_SEQ]` is sized at compile time, so raising MAX_SEQ from 32
// to 64 cost every pass 192 VGPRs instead of 72 — one wave per SIMD instead of
// three — even a pass using 32 slots. Measured: a 512-token prompt at tile 32
// went from 598.5 to 541.7 tok/s purely from the wider array.
//
// Specialized, each pipeline variant carries only the slots it needs, and the
// loops below unroll because the bound is a constant rather than a push value.
// The host creates one variant per power of two and picks by token count.
layout(constant_id = 0) const int ACC_N = 64;

// One subgroup per output row; every sequence multiplies the same matrix, so
// NS is the batch width and one weight read serves all of them.
void main() {
    uint row = gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID;
    if (row >= pc.rows) return;

    float acc[ACC_N];
    for (int i = 0; i < ACC_N; ++i) acc[i] = 0.0;
    Q6K_ACC(w, pc.ql_u, pc.qh_u, pc.sc_u, pc.d_u, row * pc.blocks, 0u, 0u, 0u, ACC_N, acc)

    for (int s = 0; s < ACC_N; ++s) {
        if (uint(s) >= pc.nseq) break;
        float t = subgroupAdd(acc[s]);
        if (subgroupElect()) outv[uint(s) * pc.rows + row] = t;
    }
}
