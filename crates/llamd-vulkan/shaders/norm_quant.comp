#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#include "common.glsl"
#include "quant.glsl"
layout(local_size_x = QK_K) in;
layout(std430, binding = 0) readonly  buffer X   { float x[];   };
layout(std430, binding = 1) readonly  buffer W   { float w[];   };
layout(std430, binding = 2) readonly  buffer INV { float inv[]; };
layout(std430, binding = 3) writeonly buffer O   { float outv[]; };
layout(std430, binding = 4) writeonly buffer QB  { uint8_t qb[]; };
layout(std430, binding = 5) writeonly buffer SB  { int   sb[];  };
layout(std430, binding = 6) writeonly buffer D   { float d[];   };
layout(push_constant) uniform P { uint nblocks; } pc;

// rms_norm(x)*w emitted as f32 AND as the biased/summed Q8_K the dot product
// reads. One pass: the f32 is needed by the F32 router matvec, the quantized
// form by every Q6_K matvec, and computing the norm twice would be waste.
void main() {
    uint s = gl_WorkGroupID.x / pc.nblocks;
    uint b = gl_WorkGroupID.x - s * pc.nblocks;
    uint t = gl_LocalInvocationID.x;
    uint n = pc.nblocks * QK_K;
    uint i = s * n + b * QK_K + t;

    float v = x[i] * inv[s] * w[b * QK_K + t];
    outv[i] = v;

    float dscale;
    uint bq = quant_bias_group(v, t, 0u, dscale);
    qb[i] = uint8_t(bq);
    if (t == 0u) d[s * pc.nblocks + b] = dscale;
    if (t < QK_K / 16u) {
        int acc = 0;
        for (uint j = 0u; j < 16u; ++j) acc += s_q[t * 16u + j];
        sb[(s * pc.nblocks + b) * 16u + t] = acc;
    }
}
