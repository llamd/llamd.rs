#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer DN { float down[]; };
layout(std430, binding = 1) readonly  buffer WT { float wt[];   };
layout(std430, binding = 2) readonly  buffer R  { float res[];  };
layout(std430, binding = 3) writeonly buffer O  { float o[];    };
layout(push_constant) uniform P { uint n_used; uint n_embd; uint nseq; } pc;
// out = residual + sum_e weights[e] * down[e], per sequence.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n_embd * pc.nseq) return;
    uint s = i / pc.n_embd;
    uint dd = i - s * pc.n_embd;
    float acc = 0.0;
    for (uint e = 0u; e < pc.n_used; ++e)
        acc += wt[s * pc.n_used + e] * down[(s * pc.n_used + e) * pc.n_embd + dd];
    o[i] = res[i] + acc;
}
