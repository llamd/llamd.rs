#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer G { float g[]; };
layout(std430, binding = 1) readonly  buffer U { float u[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform P { uint n; } pc;
// SiLU on the GATE only, then elementwise with up. SwiGLU is not symmetric:
// applying it to `up`, or after the multiply, still produces fluent text.
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) { float x = g[i]; o[i] = (x / (1.0 + exp(-x))) * u[i]; }
}
