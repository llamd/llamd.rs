#version 450
//
// The expert DOWN projection, expert-major.
//
// One difference from the gate and up variant, and it is the bug that would
// otherwise produce fluent nonsense: each expert consumed its OWN
// silu(gate) * up, so the activation is indexed by the (token, slot) PAIR — which
// is `pslot` — and not by the token. The gate and up projections share one
// activation per token; this one does not.
//
// WHY THIS IS THE PREFILL WIN. At 32 tokens the routed experts are 96.5% of a
// tile's weight traffic — the attention projections are 3.5%, because they are
// read once per tile while each token picks its own eight of 128 experts. The
// token-major kernel runs one row per (token, expert) pair, so an expert chosen
// by three tokens has its weights read three times.
//
// At 32 tokens, 112 distinct experts serve 256 pairs: 2.3 tokens per chosen
// expert, and therefore ~2.3x fewer expert weight reads. That is 2.3x on 96.5% of
// the traffic, against 3.5% for anything done to the attention path — which is
// what the tiled GEMM attempt spent its effort on. See benchmarks.md §16.
//
// THE DECOMPOSITION IS THE MATVEC'S, deliberately: one row per subgroup, a lane
// striding over the row's uint4 groups. That shape measured best three times
// (§16) because it keeps two waves per hardware slot. The only changes are that
// the activation index is GATHERED through `ptoken` and the output index
// SCATTERED through `pslot`.

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer W   { uint  w[];      };
layout(std430, binding = 1) readonly buffer QB  { uint  qb[];     };
layout(std430, binding = 2) readonly buffer SB  { int   sb[];     };
layout(std430, binding = 3) readonly buffer AD  { float ad[];     };
layout(std430, binding = 4) buffer          O   { float outv[];   };
layout(std430, binding = 5) readonly buffer GS  { int   gstart[]; };
layout(std430, binding = 6) readonly buffer GC  { int   gcount[]; };
layout(std430, binding = 7) readonly buffer PT  { int   ptoken[]; };
layout(std430, binding = 8) readonly buffer PS  { int   pslot[];  };

layout(push_constant) uniform Push {
    uint ql_u; uint qh_u; uint sc_u; uint d_u;
    uint blocks; uint rows; uint n_used; uint nseq;
} pc;
#include "common.glsl"

// The accumulator width, a SPECIALIZATION CONSTANT.
//
// WHY. `float acc[MAX_SEQ]` is sized at compile time, so raising MAX_SEQ from 32
// to 64 cost every pass 192 VGPRs instead of 72 — one wave per SIMD instead of
// three — even a pass using 32 slots. Measured: a 512-token prompt at tile 32
// went from 598.5 to 541.7 tok/s purely from the wider array.
//
// Specialized, each pipeline variant carries only the slots it needs, and the
// loops below unroll because the bound is a constant rather than a push value.
// The host creates one variant per power of two and picks by token count.
layout(constant_id = 0) const int ACC_N = 64;

void main() {
    // gl_WorkGroupID.y IS the expert id. The host dispatches n_expert of them and
    // the empty ones return at once — at 32 tokens only 16 of 128 are empty, and
    // an immediate return costs nothing. That avoids needing the group count,
    // which only exists on the device, back on the host to size the dispatch.
    uint expert = gl_WorkGroupID.y;
    int count = gcount[expert];
    if (count <= 0) return;
    int start = gstart[expert];

    uint row = gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID;
    if (row >= pc.rows) return;

    uint ri = (expert * pc.rows + row) * pc.blocks;
    uint qlr = pc.ql_u + ri * 32u;
    uint qhr = pc.qh_u + ri * 16u;
    uint scr = pc.sc_u + ri * 4u;
    uint n_u4 = pc.blocks * 8u;

    // CHUNKED OVER THE GROUP, and this is what makes a wide prefill tile pay.
    //
    // A group is every (token, slot) pair that chose this expert. The accumulator
    // is ACC_N wide, so a group larger than that is processed ACC_N tokens at a
    // time, re-reading the weight row once per chunk. Before this loop existed the
    // host had to keep the whole tile no wider than ACC_N, which capped the tile
    // at 32 — and at a 32-token tile an expert serves only 2.3 tokens, so its
    // weights were read 14x more often than necessary across a 512-token prompt.
    //
    // With the tile at 512 an expert serves about 32 tokens, which is ONE chunk:
    // the weights are read once. Expert traffic for a 512-token prompt falls from
    // 329 GB to 24.8 GB. See benchmarks.md §19.
    //
    // `count` is the same for every lane in the workgroup — one expert per
    // workgroup — so the loop trip count is uniform and the subgroupAdd at the
    // bottom is never reached divergently.
    for (int base = 0; base < count; base += ACC_N) {
        int live = min(ACC_N, count - base);
        float acc[ACC_N];
        for (int i = 0; i < ACC_N; ++i) acc[i] = 0.0;

        for (uint u = gl_SubgroupInvocationID; u < n_u4; u += gl_SubgroupSize) {
            uint b = u >> 3u, jb0 = (u & 7u) << 4u;
            uint h = jb0 >> 6u, m0 = jb0 & 63u;
            uint shl = (m0 >= 32u) ? 2u : 0u, s4 = shl + 4u;

            uint q0 = w[qlr + u * 4u + 0u], q1 = w[qlr + u * 4u + 1u];
            uint q2 = w[qlr + u * 4u + 2u], q3 = w[qlr + u * 4u + 3u];
            uint hb = qhr + b * 16u + h * 8u + ((m0 & 31u) >> 2u);
            uint h0 = w[hb + 0u], h1 = w[hb + 1u], h2 = w[hb + 2u], h3 = w[hb + 3u];

            uint l0 = (q0 & 0x0F0F0F0Fu) | (((h0 >> shl) & 0x03030303u) << 4u);
            uint l1 = (q1 & 0x0F0F0F0Fu) | (((h1 >> shl) & 0x03030303u) << 4u);
            uint l2 = (q2 & 0x0F0F0F0Fu) | (((h2 >> shl) & 0x03030303u) << 4u);
            uint l3 = (q3 & 0x0F0F0F0Fu) | (((h3 >> shl) & 0x03030303u) << 4u);
            uint i0 = ((q0 >> 4u) & 0x0F0F0F0Fu) | (((h0 >> s4) & 0x03030303u) << 4u);
            uint i1 = ((q1 >> 4u) & 0x0F0F0F0Fu) | (((h1 >> s4) & 0x03030303u) << 4u);
            uint i2 = ((q2 >> 4u) & 0x0F0F0F0Fu) | (((h2 >> s4) & 0x03030303u) << 4u);
            uint i3 = ((q3 >> 4u) & 0x0F0F0F0Fu) | (((h3 >> s4) & 0x03030303u) << 4u);

            uint swl = dotPacked4x8AccSatEXT(l0, 0x01010101u, 0u);
            swl = dotPacked4x8AccSatEXT(l1, 0x01010101u, swl);
            swl = dotPacked4x8AccSatEXT(l2, 0x01010101u, swl);
            swl = dotPacked4x8AccSatEXT(l3, 0x01010101u, swl);
            uint swh = dotPacked4x8AccSatEXT(i0, 0x01010101u, 0u);
            swh = dotPacked4x8AccSatEXT(i1, 0x01010101u, swh);
            swh = dotPacked4x8AccSatEXT(i2, 0x01010101u, swh);
            swh = dotPacked4x8AccSatEXT(i3, 0x01010101u, swh);
            int cl = -128 * int(swl) + 32 * 128 * 16;
            int ch = -128 * int(swh) + 32 * 128 * 16;

            uint si = b * 16u + h * 8u + (m0 >> 4u);
            int scl = bitfieldExtract(int(w[scr + (si >> 2u)]), int(8u * (si & 3u)), 8);
            uint sj = si + 4u;
            int sch = bitfieldExtract(int(w[scr + (sj >> 2u)]), int(8u * (sj & 3u)), 8);
            uint di = pc.d_u + ((ri + b) >> 1u);
            vec2 dp = unpackHalf2x16(w[di]);
            float dw = (((ri + b) & 1u) == 0u) ? dp.x : dp.y;

            uint bu = b * 64u + h * 32u + (m0 >> 2u);
            uint g16 = b * 16u + h * 8u + (m0 >> 4u);

            // THE REUSE: the weights above were unpacked once; every token that chose
            // this expert now consumes them.
            for (int i = 0; i < ACC_N; ++i) {
                if (i >= live) break;
                uint slot = uint(pslot[start + base + i]);
                uint ab = slot * pc.blocks * 64u + bu;
                uint wl = dotPacked4x8AccSatEXT(l0, qb[ab + 0u], 0u);
                wl = dotPacked4x8AccSatEXT(l1, qb[ab + 1u], wl);
                wl = dotPacked4x8AccSatEXT(l2, qb[ab + 2u], wl);
                wl = dotPacked4x8AccSatEXT(l3, qb[ab + 3u], wl);
                uint ah = ab + 16u;
                uint wh = dotPacked4x8AccSatEXT(i0, qb[ah + 0u], 0u);
                wh = dotPacked4x8AccSatEXT(i1, qb[ah + 1u], wh);
                wh = dotPacked4x8AccSatEXT(i2, qb[ah + 2u], wh);
                wh = dotPacked4x8AccSatEXT(i3, qb[ah + 3u], wh);
                int sbl = sb[slot * pc.blocks * 16u + g16];
                int sbh = sb[slot * pc.blocks * 16u + g16 + 4u];
                int il = scl * (int(wl) + cl - 32 * sbl);
                int ih = sch * (int(wh) + ch - 32 * sbh);
                acc[i] += dw * ad[slot * pc.blocks + b] * float(il + ih);
            }
        }

        for (int i = 0; i < ACC_N; ++i) {
            if (i >= live) break;
            float sum = subgroupAdd(acc[i]);
            if (subgroupElect()) outv[uint(pslot[start + base + i]) * pc.rows + row] = sum;
        }
    }
}
