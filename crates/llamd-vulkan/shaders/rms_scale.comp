#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = WG) in;
layout(std430, binding = 0) readonly  buffer X   { float x[];   };
layout(std430, binding = 1) writeonly buffer INV { float inv[]; };
layout(push_constant) uniform P { uint n; float eps; } pc;

shared float sh[WG];

// One workgroup per sequence: 1/rms of that sequence's vector.
void main() {
    uint t = gl_LocalInvocationID.x;
    uint base = gl_WorkGroupID.x * pc.n;
    float a = 0.0;
    for (uint i = t; i < pc.n; i += WG) { float v = x[base + i]; a += v * v; }
    sh[t] = a;
    barrier();
    for (uint st = WG / 2u; st > 0u; st >>= 1u) {
        if (t < st) sh[t] += sh[t + st];
        barrier();
    }
    if (t == 0u) inv[gl_WorkGroupID.x] = inversesqrt(sh[0] / float(pc.n) + pc.eps);
}
